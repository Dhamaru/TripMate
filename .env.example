# TripMate — environment template
# Copy to `.env` and fill in. PLACEHOLDERS ONLY — never put a real key here.
# Authoritative definitions live in server/config.ts (zod schema).
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string. For local work also set MONGODB_DB_NAME below,
# because the default database name is the production one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
# Random 64-char hex string each: `openssl rand -hex 32`
SESSION_SECRET=replace-with-64-random-hex
JWT_SECRET=replace-with-64-random-hex

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Defaults to `tripmate` (the production DB name) — set something else locally.
MONGODB_DB_NAME=tripmate-dev
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb

# ── AI (Atlas chat + trip planner) ────────────────────────────────────────
# Google AI Studio key. The app talks to Gemini through its OpenAI-compatible
# endpoint using the `openai` SDK as transport — not a real OpenAI account.
GEMINI_API_KEY=
# Google Cloud key (Places, Maps, Translation). Plain Cloud Console key.
GOOGLE_API_KEY=

# ── Google sign-in (optional) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / notifications (optional — features no-op when unset) ─────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM_EMAIL=
RESEND_API_KEY=
# Admin notification address for feedback (no default — must be set to enable).
ADMIN_EMAIL=
# Service-to-service secret for the feedback-triage routine. Unset = the admin
# feedback endpoints fail closed on purpose.
ADMIN_SECRET=

# ── Web push (optional — push is a no-op when unset) ──────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Weather (optional) ────────────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Rate limiting / quotas (all optional — sensible defaults in config.ts) ─
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
AI_RATE_LIMIT_MAX=
AI_RATE_LIMIT_WINDOW_MS=
GENERATION_RATE_LIMIT_MAX=
GENERATION_RATE_LIMIT_WINDOW_MS=
ACCOUNT_LOCK_MAX_ATTEMPTS=20
ACCOUNT_LOCK_DURATION_MS=900000
GOOGLE_DAILY_USER_MAX=300
GOOGLE_DAILY_GUEST_MAX=40
GOOGLE_DAILY_GLOBAL_MAX=5000
# CSRF is on by default in production, off in development. Set to false to force off.
CSRF_ENABLED=

# ── Scripts / tooling ─────────────────────────────────────────────────────
# Base URL for `npm run atlas:golden-eval` (defaults to localhost).
BASE_URL=http://localhost:5000
ENABLE_SCHEDULER=
FORCE_DB_CLEAR=
FORCE_DB_SEED=

# ── Frontend (Vite — only needed if the client is served from another origin)
VITE_API_URL=

# Aliases accepted by server/config.ts (deprecated — prefer the names above):
#   Google_Gemini_Key        -> GEMINI_API_KEY
#   GOOGLE_PLACES_API_KEY    -> GOOGLE_API_KEY
#   GOOGLE_MAPS_API_KEY      -> GOOGLE_API_KEY
