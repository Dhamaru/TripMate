{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"cross-env NODE_ENV=development NO_VITE=1 tsx watch server/index.ts\" \"npm run dev:client\"",
    "dev:standalone": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development node --max-http-header-size=262144 node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "dev:client": "vite --port 3000",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'server/**/*.ts' 'client/src/**/*.{ts,tsx}' --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/backend tests/frontend tests/agents tests/sse",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:clear": "tsx server/scripts/clearDb.ts",
    "test:parser": "tsx client/src/lib/__tests__/runParserTests.ts"
  },
